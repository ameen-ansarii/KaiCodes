{
  "expo": {
    "name": "KaiCode: Daily DSA with Kai",
    "slug": "kaicode",
    "version": "1.0.0",
    "owner": "xv.amen",
    "orientation": "portrait",
    "icon": "./assets/images/kailogo.png",
    "scheme": "kaicode",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/kailogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.xvamen.kaicode",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kailogo.png",
        "backgroundColor": "#7C3AED"
      }
    },
    "web": {
      "favicon": "./assets/images/kailogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kailogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7C3AED"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "34f491a9-2d1e-418c-957a-acfac2c711ff"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/34f491a9-2d1e-418c-957a-acfac2c711ff",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
